rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // GLOBAL HELPERS
    // ----------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // APP CONFIG (Settings, Animations, Auth)
    // ----------------------------------------------------
    
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // ITEMS (Courses, Books, Strategies, Portfolio, Links)
    // ----------------------------------------------------
    
    match /items/{itemId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // FILE CHUNKS (Permanent Large Media & PDF Chunks)
    // ----------------------------------------------------

    match /file_chunks/{chunkId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // APP STATE (Legacy migration support)
    // ----------------------------------------------------

    match /app_state/{docId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // SUBMISSIONS
    // ----------------------------------------------------
    
    match /submissions/{subId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // AUDIT LOGS
    // ----------------------------------------------------
    
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}

