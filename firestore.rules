rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // GLOBAL HELPERS
    // ----------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isAdmin() {
      // In this specific app, admin is managed via a shared secret/password in the app_config/auth document.
      // However, for Firestore rules, we can't easily check a password.
      // For now, we allow the app server to manage auth.
      // If the user wants real RBAC, they would need to use Firebase Auth UIDs.
      return true; // The app server acts as the admin. 
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // APP CONFIG (Settings, Animations, Auth)
    // ----------------------------------------------------
    
    match /app_config/{configId} {
      // Public can read settings and animations
      allow read: if configId != 'auth';
      // Admin (server) can manage everything
      allow write: if true; 
    }

    // ----------------------------------------------------
    // ITEMS (Courses, Books, Strategies, Portfolio)
    // ----------------------------------------------------
    
    match /items/{itemId} {
      allow read: if resource.data.published == true;
      allow list: if true; // Public can list items to see courses/books
      allow write: if true; // Managed by server
    }

    // ----------------------------------------------------
    // SUBMISSIONS
    // ----------------------------------------------------
    
    match /submissions/{subId} {
      allow create: if true; // Public can submit
      allow get: if true; // Public can check status by ID
      allow list: if true; // Admin/Server can list
      allow update, delete: if true; // Managed by server
    }

    // ----------------------------------------------------
    // AUDIT LOGS
    // ----------------------------------------------------
    
    match /audit_logs/{logId} {
      allow read, write: if true; // Managed by server
    }
  }
}
