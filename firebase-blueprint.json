{
  "entities": {
    "WebsiteSettings": {
      "title": "Website Settings",
      "description": "Global branding and content settings for the platform.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "tagline": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "profileImageUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "heroBannerUrl": { "type": "string" }
      }
    },
    "AppItem": {
      "title": "Application Item",
      "description": "Generic container for courses, books, strategies, and portfolio items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["course", "book", "strategy", "portfolio"] },
        "title": { "type": "string" },
        "data": { "type": "object" },
        "order": { "type": "number" },
        "published": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "title"]
    },
    "AccountSubmission": {
      "title": "Account Submission",
      "description": "Trader account ID verification request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System event log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/app_config/settings": {
      "schema": "WebsiteSettings",
      "description": "Global website configuration."
    },
    "/app_config/animations": {
      "schema": "object",
      "description": "Visual effect settings."
    },
    "/app_config/auth": {
      "schema": "object",
      "description": "Admin authentication configuration."
    },
    "/items/{itemId}": {
      "schema": "AppItem",
      "description": "Individual content items (Courses, Books, Strategies, Portfolio)."
    },
    "/submissions/{subId}": {
      "schema": "AccountSubmission",
      "description": "Trader verification submissions."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System activity logs."
    },
    "/file_chunks/{chunkId}": {
      "schema": "object",
      "description": "Chunked permanent storage for uploaded files and PDFs."
    }
  }
}
